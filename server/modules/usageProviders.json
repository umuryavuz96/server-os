{
  "_doc": "Provider registry for the Usage tab. One entry per service. detect: env = regexes on variable NAMES in the env file (values are never read here), bin = executable on PATH, login = args that exit 0 only when signed in (needs bin), file = paths whose existence counts (~ expands), app = app bundles. kind: paid (cost matters), free, local (runs on this device). fetch = id of a usage fetcher in usage.ts. prices = monthly USD by lower-case plan name; flat = fixed price { usd, per } when the plan is unknown. icon = selfh.st slug or lucide:<name>, fallback = lucide name.",
  "providers": [
    { "id": "claude-code", "name": "Claude Code", "icon": "claude", "fallback": "sparkles", "kind": "paid", "group": "AI", "billing": "https://claude.ai/settings/billing", "fetch": "claude",
      "detect": { "file": ["~/.claude.json"], "bin": "claude" }, "prices": { "pro": 20, "max 5x": 100, "max 20x": 200 }, "note": "Subscription windows come from Claude Code's own login." },
    { "id": "anthropic-api", "name": "Anthropic API", "icon": "anthropic", "fallback": "sparkles", "kind": "paid", "group": "AI", "billing": "https://console.anthropic.com/settings/billing", "fetch": "anthropic",
      "detect": { "env": ["(^|_)ANTHROPICS?_(API_|ADMIN_)?KEY$"] }, "note": "Pay as you go. Month-to-date spend needs an Admin API key (sk-ant-admin…)." },
    { "id": "openai", "name": "OpenAI API", "icon": "openai", "fallback": "sparkles", "kind": "paid", "group": "AI", "billing": "https://platform.openai.com/settings/organization/billing/overview", "fetch": "openai",
      "detect": { "env": ["^OPENAI_(API|ADMIN)_KEY$"] }, "note": "Pay as you go. Month-to-date spend needs an admin key." },
    { "id": "gemini", "name": "Google Gemini API", "icon": "google-gemini", "fallback": "sparkles", "kind": "paid", "group": "AI", "billing": "https://aistudio.google.com/usage",
      "detect": { "env": ["^(GEMINI|GOOGLE_GENAI|GOOGLE_AI)_API_KEY$", "^GOOGLE_API_KEY$"] }, "note": "Free tier with limits, then pay as you go." },
    { "id": "groq", "name": "Groq", "icon": "groq", "fallback": "zap", "kind": "paid", "group": "AI", "billing": "https://console.groq.com/settings/billing", "detect": { "env": ["^GROQ_API_KEY$"] } },
    { "id": "mistral", "name": "Mistral", "icon": "mistral-ai", "fallback": "sparkles", "kind": "paid", "group": "AI", "billing": "https://console.mistral.ai/billing/", "detect": { "env": ["^MISTRAL_API_KEY$"] } },
    { "id": "replicate", "name": "Replicate", "icon": "replicate", "fallback": "sparkles", "kind": "paid", "group": "AI", "billing": "https://replicate.com/account/billing", "detect": { "env": ["^REPLICATE_API_(TOKEN|KEY)$"] } },
    { "id": "fal", "name": "fal.ai", "icon": "fal", "fallback": "sparkles", "kind": "paid", "group": "AI", "billing": "https://fal.ai/dashboard/usage-billing", "detect": { "env": ["^FAL_(KEY|API_KEY)$"] } },
    { "id": "elevenlabs", "name": "ElevenLabs", "icon": "elevenlabs", "fallback": "audio-lines", "kind": "paid", "group": "AI", "billing": "https://elevenlabs.io/app/subscription", "fetch": "elevenlabs",
      "detect": { "env": ["^ELEVENLABS_API_KEY$", "^XI_API_KEY$"] }, "prices": { "free": 0, "starter": 5, "creator": 22, "pro": 99, "scale": 330, "business": 1320 }, "note": "Characters used this billing period; the key needs the User: read permission." },
    { "id": "deepgram", "name": "Deepgram", "icon": "deepgram", "fallback": "audio-lines", "kind": "paid", "group": "AI", "billing": "https://console.deepgram.com/billing", "detect": { "env": ["^DEEPGRAM_API_KEY$"] } },
    { "id": "assemblyai", "name": "AssemblyAI", "icon": "assemblyai", "fallback": "audio-lines", "kind": "paid", "group": "AI", "billing": "https://www.assemblyai.com/dashboard/account", "detect": { "env": ["^ASSEMBLYAI_API_KEY$"] } },
    { "id": "cursor", "name": "Cursor", "icon": "cursor", "fallback": "square-terminal", "kind": "paid", "group": "AI", "billing": "https://cursor.com/dashboard?tab=billing",
      "detect": { "bin": "cursor-agent", "app": ["/Applications/Cursor.app"] }, "note": "No public usage API; set the plan price yourself." },
    { "id": "finnhub", "name": "Finnhub", "icon": "lucide:trending-up", "fallback": "trending-up", "kind": "free", "group": "Data", "billing": "https://finnhub.io/dashboard",
      "detect": { "env": ["^FINNHUB_(API_)?KEY$", "^FINNHUB_TOKEN$"] }, "note": "Free tier: 60 calls a minute. Paid plans start at the dashboard." },
    { "id": "posthog", "name": "PostHog", "icon": "posthog", "fallback": "trending-up", "kind": "paid", "group": "Data", "billing": "https://eu.posthog.com/organization/billing", "detect": { "env": ["(^|_)POSTHOG_"] }, "note": "Free monthly allowance, then usage based." },
    { "id": "supabase", "name": "Supabase", "icon": "supabase", "fallback": "database", "kind": "paid", "group": "Infrastructure", "billing": "https://supabase.com/dashboard/org/_/billing", "detect": { "env": ["(^|_)SUPABASE_"] }, "note": "Free projects pause after 7 idle days; Pro is $25 per organisation." },
    { "id": "cloudflare", "name": "Cloudflare", "icon": "cloudflare", "fallback": "cloud", "kind": "paid", "group": "Infrastructure", "billing": "https://dash.cloudflare.com/?to=/:account/billing", "fetch": "cloudflare",
      "detect": { "env": ["^(CLOUDFLARE|CF)_.*(TOKEN|API_KEY)$"], "bin": "wrangler" }, "note": "Plan per zone, read with a token that has Zone: read." },
    { "id": "github", "name": "GitHub", "icon": "github", "fallback": "code", "kind": "free", "group": "Developer", "billing": "https://github.com/settings/billing", "fetch": "github",
      "detect": { "env": ["^(GITHUB|GH)_TOKEN$"], "bin": "gh", "login": ["auth", "status"] }, "prices": { "free": 0, "pro": 4 }, "note": "Plan and Actions minutes from the signed-in account." },
    { "id": "apple-developer", "name": "Apple Developer Program", "icon": "apple", "fallback": "smartphone", "kind": "paid", "group": "Developer", "billing": "https://developer.apple.com/account", "detect": { "env": ["^ASC_(KEY_ID|ISSUER_ID)$"] }, "flat": { "usd": 99, "per": "year" }, "note": "Yearly membership, shown per month." },
    { "id": "launchdarkly", "name": "LaunchDarkly", "icon": "lucide:flag", "fallback": "package", "kind": "paid", "group": "Developer", "billing": "https://app.launchdarkly.com/settings/billing", "detect": { "env": ["^LAUNCHDARKLY_"] } },
    { "id": "stripe", "name": "Stripe", "icon": "stripe", "fallback": "wallet", "kind": "paid", "group": "Payments", "billing": "https://dashboard.stripe.com/settings/billing", "detect": { "env": ["^STRIPE_(SECRET|API|RESTRICTED)_KEY$"] }, "note": "No monthly fee; a fee per payment." },
    { "id": "resend", "name": "Resend", "icon": "resend", "fallback": "send", "kind": "paid", "group": "Messaging", "billing": "https://resend.com/settings/billing", "detect": { "env": ["^RESEND_API_KEY$"] } },
    { "id": "twilio", "name": "Twilio", "icon": "twilio", "fallback": "send", "kind": "paid", "group": "Messaging", "billing": "https://console.twilio.com/us1/billing", "detect": { "env": ["^TWILIO_(AUTH_TOKEN|API_KEY)"] } },
    { "id": "pushover", "name": "Pushover", "icon": "pushover", "fallback": "bell", "kind": "paid", "group": "Messaging", "billing": "https://pushover.net/dashboard", "detect": { "env": ["^PUSHOVER_(APP_|API_)?(TOKEN|KEY)$"] }, "note": "One-time purchase per platform." },
    { "id": "telegram", "name": "Telegram bots", "icon": "telegram", "fallback": "send", "kind": "free", "group": "Messaging", "billing": "https://core.telegram.org/bots", "detect": { "env": ["^TELEGRAM_.*TOKEN$"] }, "note": "The Bot API is free." },
    { "id": "tailscale", "name": "Tailscale", "icon": "tailscale", "fallback": "network", "kind": "free", "group": "Infrastructure", "billing": "https://login.tailscale.com/admin/settings/billing", "detect": { "bin": "tailscale", "login": ["status"] }, "note": "Personal use is free; paid plans per user." },
    { "id": "docker", "name": "Docker Desktop", "icon": "docker", "fallback": "boxes", "kind": "free", "group": "Infrastructure", "billing": "https://app.docker.com/billing", "detect": { "app": ["/Applications/Docker.app"] }, "note": "Free for personal use and small businesses." },
    { "id": "ollama", "name": "Ollama", "icon": "ollama", "fallback": "cpu", "kind": "local", "group": "AI", "billing": "https://ollama.com", "detect": { "bin": "ollama" }, "note": "Runs on this device; costs only electricity." }
  ]
}
